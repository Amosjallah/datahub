# ============================================================
# FA DIGITAL SERVICES LTD. / QUICKNET DATA — ENVIRONMENT TEMPLATE
# Copy this file to .env and replace placeholder values with your real keys.
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_URL=https://quicknetdata.com

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only service role key (Never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Paystack Payment Gateway API Keys (Ghana Cedis GHS Integration)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# Hubtel Ghana APIs (Mobile Money Collections, Disbursements, Bills & Checkout)
# Get keys from: https://unity.hubtel.com
HUBTEL_CLIENT_ID=your_hubtel_client_id_here
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_here
HUBTEL_BASE_URL=https://api-txnmgt.hubtel.com/disbursements
HUBTEL_CHECKOUT_URL=https://payproxyapi.hubtel.com/items/initiate

# DatamartGH VTU API (Airtime & Data Bundles — Primary Provider)
DATAMARTGH_API_KEY=your_datamartgh_api_key_here
DATAMARTGH_BASE_URL=https://szhjqivcywijzdusueob.supabase.co/functions/v1

# ResellerXpress VTU & Data API Credentials (Fallback Provider)
RESELLERXPRESS_API_KEY=rx_live_your_resellerxpress_api_key_here
RESELLERXPRESS_BASE_URL=https://resellerxpress.shop/api/v1

# Mobile Money Direct API Keys (Optional Direct Integration)
MTN_MOMO_API_KEY=your_mtn_momo_api_key_here

# SMS Gateway API Configuration
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=FADIGITAL

# Email Service API Configuration (e.g., Resend, SendGrid)
EMAIL_SERVICE_API_KEY=re_your_email_api_key_here
EMAIL_SERVICE_FROM=noreply@fadigital.com

# WhatsApp Business API Configuration (Optional)
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Push Notification Configuration (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_fcm_server_key_here
NEXT_PUBLIC_FCM_VAPID_KEY=your_fcm_vapid_key_here

# Betting Platform API Credentials (Optional)
SPORTYBET_API_KEY=your_sportybet_api_key_here
BETWAY_API_KEY=your_betway_api_key_here
